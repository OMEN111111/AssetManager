# deps / build
node_modules/
dist/
*.tsbuildinfo

# runtime data (sqlite, generated thumbs, logs)
app/data/
app/shot-*.png
app/shot-*.jpg

# build output (icons are committed intentionally)
app/build/*
!app/build/icon.ico
!app/build/icon.png
!app/build/drag-icon.png

# packaged artifacts
app/release/

# test assets & browser profiles (large / machine specific)
devtest/assets/
devtest/.chrome*/
devtest/dom.txt
devtest/node_modules/
devtest/ies-data/
devtest/render.png

# tooling artifacts
.dsh-vision-router/
*.log
__pycache__/
*.pyc
.DS_Store
Thumbs.db

# release upload staging
dist-release/

# UE 测试工程（AMTest）：引擎生成物 + 插件拷贝 + 临时服务数据，一律不入库
devtest/ue/AMTest*/Content/
devtest/ue/AMTest*/Intermediate/
devtest/ue/AMTest*/Saved/
devtest/ue/AMTest*/DerivedDataCache/
devtest/ue/AMTest*/Plugins/
devtest/ue/AMTest*/Config/
devtest/ue/.data/
devtest/ue/work/
devtest/ue/thread_out.json
devtest/ue/thread_probe.py

devtest/ue/t*_probe.py
devtest/ue/t*_out.json
devtest/ue/t*_run.log

# Maya 测试：临时服务数据 + 测试产物（插件本身在 app/bridge/maya/）
devtest/maya/.data/
devtest/maya/work/


# 置换对齐验证页（esbuild 产物与截图，可随时重打）
devtest/disp/node_modules/
devtest/disp/*.js
devtest/disp/out-*.png

devtest/disp/*.css

# 3ds Max 测试：临时服务数据 + 测试产物（插件本身在 app/bridge/max/）
devtest/max/.data/
devtest/max/work/
